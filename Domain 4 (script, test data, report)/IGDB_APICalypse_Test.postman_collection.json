  "item": [
    {
      "name": "IGDB Automation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Đọc dữ liệu từ file CSV\r",
              "let testCase = pm.iterationData.get(\"test_case\");\r",
              "let expectedStatus = parseInt(pm.iterationData.get(\"expected_status\"));\r",
              "\r",
              "// 2. Kiểm tra HTTP Status Code\r",
              "pm.test(testCase + \" - Kỳ vọng mã trạng thái: \" + expectedStatus, function () {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "});\r",
              "\r",
              "// 3. Rẽ nhánh kiểm tra Body dựa trên kết quả kỳ vọng\r",
              "if (expectedStatus === 200) {\r",
              "    // Với API thành công, kiểm tra xem có phải mảng hoặc object hợp lệ không\r",
              "    pm.test(\"[\" + testCase + \"] - Dữ liệu trả về phải có cấu trúc hợp lệ\", function () {\r",
              "        let jsonData = pm.response.json();\r",
              "        // IGDB trả về Array cho query thường, hoặc Array of Objects cho Multi-query\r",
              "        pm.expect(jsonData);\r",
              "        // .to.not.be.empty\r",
              "    });\r",
              "} else {\r",
              "    // Với các case bắt lỗi (400, 403), hệ thống bắt buộc phải trả về thông báo lỗi\r",
              "    pm.test(\"[\" + testCase + \"] - Hệ thống bắt lỗi và trả về chi tiết lỗi\", function () {\r",
              "        let responseText = pm.response.text();\r",
              "        pm.expect(responseText).to.include(\"title\"); // IGDB error object thường có key 'title'\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Client-ID",
            "value": "5yxbh1m1zyjwm2rtynl94yua8kz6uz",
