        {
          "listen": "test",
          "script": {
            "exec": [
              "// Lấy Header từ tab Headers bạn đã nhập để dùng chung",
              "const reqHeader = {",
              "    'Client-ID': pm.request.headers.get('Client-ID'),",
              "    'Authorization': pm.request.headers.get('Authorization'),",
              "    'Content-Type': 'text/plain'",
              "};",
              "const url = \"https://api.igdb.com/v4/games\";",
              "",
              "// --- GỬI REQUEST NGẦM 1: Test Invalid field ---",
              "const bodyStep1 = \"fields id, name, invalid_field_xyz; limit 1;\";",
              "pm.sendRequest({",
              "    url: url, method: 'POST', header: reqHeader,",
              "    body: { mode: 'raw', raw: bodyStep1 }",
              "}, function (err, res) {",
              "    pm.test(\"TC3.01 - Step 1: Invalid field bị bỏ qua, status 200\", function () {",
              "        pm.expect(res.code).to.eql(200); // Check status code",
              "        var j = res.json();",
              "        pm.expect(j).to.be.an('array');",
              "        j.forEach(item => { pm.expect(item).to.not.have.property('invalid_field_xyz'); });",
              "    });",
              "});",
              "",
              "// --- GỬI REQUEST NGẦM 2: Test SQL Injection ---",
              "const bodyStep2 = 'search \"\\'; DROP TABLE games; --\"; fields name;';",
              "pm.sendRequest({",
              "    url: url, method: 'POST', header: reqHeader,",
              "    body: { mode: 'raw', raw: bodyStep2 }",
              "}, function (err, res) {",
              "    pm.test(\"TC3.01 - Step 2: SQL Injection xử lý như text, không lộ dữ liệu\", function () {",
              "        pm.expect(res.code).to.eql(200);",
              "        var bodyText = res.text();",
              "        pm.expect(bodyText).to.not.include('stack');",
              "        pm.expect(bodyText).to.not.include('DROP TABLE');",
              "        pm.expect(bodyText).to.not.include('syntax error');",
              "    });",
              "});",
              "",
              "// --- GỬI REQUEST NGẦM 3: Test Child Property ---",
              "const bodyStep3 = \"fields name, name.invalid_child; limit 3;\";",
              "pm.sendRequest({",
              "    url: url, method: 'POST', header: reqHeader,",
              "    body: { mode: 'raw', raw: bodyStep3 }",
              "}, function (err, res) {",
              "    pm.test(\"TC3.01 - Step 3: Child property trên String field bị bỏ qua\", function () {",
              "        pm.expect(res.code).to.eql(200);",
              "        var j = res.json();",
              "        pm.expect(j).to.be.an('array');",
              "        j.forEach(item => { pm.expect(item).to.not.have.property('invalid_child'); });",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
