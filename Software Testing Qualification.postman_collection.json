            "exec": [
              "// 1. Kiểm tra HTTP Status Code phải là 400 (Bad Request)\r",
              "pm.test(\"Status code is 400 Bad Request\", function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra nội dung body trả về có báo lỗi thiếu client_id không\r",
              "pm.test(\"Response báo lỗi thiếu thông tin client_id\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Đảm bảo response có trả về trường báo lỗi (thường là 'message' hoặc 'error')\r",
              "    pm.expect(jsonData).to.have.property(\"message\");\r",
              "    \r",
              "    // Kiểm tra xem câu thông báo lỗi có chứa từ khóa 'client id' hay không \r",
              "    // (Chuyển về chữ thường để so sánh cho chắc chắn)\r",
              "    pm.expect(jsonData.message.toLowerCase()).to.include(\"client id\");\r",
              "    });\r",
              "\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "    var jsonData = pm.response.json();\r",
              "    if (jsonData.access_token) {\r",
              "        pm.environment.set(\"twitch_access_token\", jsonData.access_token);\r",
              "        console.log(\"Đã lưu Token vào biến môi trường!\");\r",
              "    }\r",
              "}"
