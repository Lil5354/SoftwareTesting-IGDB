          "listen": "test",
          "script": {
            "exec": [
              "// 1. Kiểm tra HTTP Status Code phải là 401 Unauthorized\r",
              "pm.test(\"Status code is 401 Unauthorized\", function () {\r",
              "    pm.response.to.have.status(401);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra nội dung body trả về có chứa thông báo lỗi xác thực không\r",
              "pm.test(\"Response body chứa thông báo lỗi thiếu Authorization\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Đảm bảo body trả về có chứa trường báo lỗi (thường là 'message')\r",
              "    pm.expect(jsonData).to.have.property(\"message\");\r",
              "    \r",
              "    // Lấy nội dung câu thông báo và chuyển thành chữ thường để dễ so sánh\r",
              "    var errorMessage = jsonData.message.toLowerCase();\r",
              "    \r",
              "    // Kiểm tra xem câu thông báo có chứa từ khóa liên quan đến xác thực không.\r",
              "    // Dùng .satisfy để linh hoạt bắt một trong các từ khóa phổ biến mà API có thể trả về.\r",
              "    pm.expect(errorMessage).to.satisfy(function(msg) {\r",
              "        return msg.includes(\"unauthorized\") || \r",
              "               msg.includes(\"authorization\") || \r",
              "               msg.includes(\"missing token\") ||\r",
              "               msg.includes(\"oauth\");\r",
              "    }, \"Thông báo lỗi không chứa từ khóa liên quan đến xác thực\");\r",
              "    \r",
              "    // (Tùy chọn) In lỗi ra console để bạn dễ theo dõi\r",
              "    console.log(\"Lỗi trả về từ API:\", jsonData.message);\r",
              "});"
