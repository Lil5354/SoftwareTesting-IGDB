    {
      "name": "Artwork_01",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Kiểm tra HTTP Status Code phải là 200 OK\r",
              "pm.test(\"Trạng thái trả về là 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra dữ liệu trả về phải là một danh sách (Array)\r",
              "pm.test(\"Response body là một danh sách (Array)\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;\r",
              "});\r",
              "\r",
              "// 3. Kiểm tra danh sách không bị rỗng và xác thực cấu trúc dữ liệu (Data Schema)\r",
              "pm.test(\"Artwork có chứa các trường thông tin như tài liệu mô tả\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Đảm bảo danh sách trả về ít nhất 1 kết quả\r",
              "    pm.expect(jsonData.length).to.be.above(0, \"Danh sách trả về đang bị rỗng!\");\r",
              "    \r",
              "    // Lấy phần tử đầu tiên ra để kiểm tra các trường (fields)\r",
              "    var firstArtwork = jsonData[0];\r",
              "    \r",
              "    // Mặc định IGDB luôn trả về ID\r",
              "    pm.expect(firstArtwork).to.have.property(\"id\");\r",
              "    \r",
