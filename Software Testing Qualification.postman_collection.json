    {
      "name": "AgeRating_05",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Kiểm tra HTTP Status Code phải là 404 hoặc 405 do sai Phương thức\r",
              "pm.test(\"Server chặn request GET ngay lập tức (Status 404 hoặc 405)\", function () {\r",
              "    // Chấp nhận pass nếu mã lỗi là 404 (Not Found) hoặc 405 (Method Not Allowed)\r",
              "    pm.expect(pm.response.code).to.be.oneOf([404, 405]);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra Response Body không chứa dữ liệu thực tế (chỉ chứa lỗi hoặc rỗng)\r",
              "pm.test(\"Response không chứa dữ liệu hợp lệ do request bị từ chối\", function () {\r",
              "    var responseText = pm.response.text().toLowerCase();\r",
              "    \r",
              "    // Đảm bảo rằng server không vô tình trả về mảng dữ liệu (dấu hiệu của 200 OK)\r",
              "    // Nếu request bị chặn từ vòng ngoài, body thường là text báo lỗi HTML, plain text, hoặc rỗng\r",
              "    pm.expect(responseText).to.satisfy(function(text) {\r",
              "        return text.includes(\"not found\") || \r",
              "               text.includes(\"not allowed\") || \r",
              "               text.includes(\"error\") || \r",
              "               text.trim() === \"\" ||\r",
              "               !text.startsWith(\"[\"); // Dữ liệu chuẩn của IGDB luôn bắt đầu bằng dấu ngoặc vuông '['\r",
              "    }, \"Server vô tình trả về dữ liệu dù sai phương thức!\");\r",
              "});\r",
              "\r",
              "// 3. (Tùy chọn) Kiểm tra thời gian phản hồi siêu nhanh\r",
              "// Vì request bị chặn ngay tại Router/Gateway mà chưa kịp vào Database, thời gian phản hồi thường rất thấp.\r",
              "pm.test(\"Thời gian phản hồi nhanh (dưới 500ms) do bị chặn từ sớm\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});"
