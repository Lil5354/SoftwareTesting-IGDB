          "listen": "test",
          "script": {
            "exec": [
              "// 1. Kiểm tra HTTP Status Code phải là 400 Bad Request\r",
              "pm.test(\"Trạng thái trả về là 400 Bad Request do sai logic filter\", function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra Response có chứa cấu trúc báo lỗi của IGDB không\r",
              "pm.test(\"Response body là một mảng chứa thông báo lỗi\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Đảm bảo phản hồi là một mảng có chứa ít nhất 1 object lỗi\r",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;\r",
              "    pm.expect(jsonData.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "// 3. Kiểm tra chi tiết thông báo lỗi có nhắc đến cú pháp hoặc từ khóa liên quan không\r",
              "pm.test(\"Thông báo lỗi chỉ ra nguyên nhân do cú pháp (Syntax Error)\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var errorObj = jsonData[0];\r",
              "    \r",
              "    // Kiểm tra trường title\r",
              "    pm.expect(errorObj).to.have.property(\"title\");\r",
              "    pm.expect(errorObj.title.toLowerCase()).to.include(\"syntax error\");\r",
              "    \r",
              "    // (Tùy chọn) In lỗi ra Console để lập trình viên dễ debug\r",
              "    console.log(\"Nguyên nhân lỗi Filter:\", errorObj.cause || errorObj.message);\r",
              "});"
