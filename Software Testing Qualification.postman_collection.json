    {
      "name": "Auth_01",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Kiểm tra HTTP Status Code có phải là 200 OK không\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra các trường dữ liệu bắt buộc trong Response Body\r",
              "pm.test(\"Response trả về đầy đủ access_token, expires_in và token_type\", function () {\r",
              "    \r",
              "    var jsonData = pm.response.json();\r",
              "\r",
              "    // Kiểm tra xem các key này có tồn tại trong JSON hay không\r",
              "    pm.expect(jsonData).to.have.property(\"access_token\");\r",
              "    pm.expect(jsonData).to.have.property(\"expires_in\");\r",
              "    \r",
              "    pm.expect(jsonData).to.have.property(\"token_type\"); \r",
              "});\r",
              "\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "    var jsonData = pm.response.json();\r",
              "    if (jsonData.access_token) {\r",
              "        pm.environment.set(\"twitch_access_token\", jsonData.access_token);\r",
              "        console.log(\"Đã lưu Token vào biến môi trường!\");\r",
              "    }\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
