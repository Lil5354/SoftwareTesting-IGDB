      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Kiểm tra HTTP Status Code phải là 404 hoặc 405\r",
              "pm.test(\"Trạng thái trả về là 404 (Not Found) hoặc 405 (Method Not Allowed)\", function () {\r",
              "    // pm.response.code lấy ra mã trạng thái hiện tại\r",
              "    // to.be.oneOf([]) kiểm tra xem mã đó có nằm trong mảng cho trước hay không\r",
              "    pm.expect(pm.response.code).to.be.oneOf([404, 405]);\r",
              "});\r",
              "\r",
              "// (Tùy chọn) Kiểm tra nội dung text trả về có chứa từ khóa báo lỗi\r",
              "pm.test(\"Response body chứa thông báo lỗi phương thức hoặc đường dẫn\", function () {\r",
              "    // Thông thường các lỗi định tuyến (routing) ở cấp độ server \r",
              "    // có thể trả về plain text hoặc HTML thay vì JSON.\r",
              "    var responseText = pm.response.text().toLowerCase();\r",
              "    \r",
              "    // Kiểm tra xem phản hồi có chứa các từ khóa báo lỗi hay không\r",
              "    pm.expect(responseText).to.satisfy(function(text) {\r",
              "        // Trả về true nếu chuỗi có chứa 'not found' hoặc 'not allowed' hoặc rỗng (do server cắt hẳn body)\r",
              "        return text.includes(\"not found\") || \r",
              "               text.includes(\"not allowed\") || \r",
              "               text.includes(\"error\") || \r",
              "               text.trim() === \"\";\r",
              "    });\r",
              "});"
            ],
